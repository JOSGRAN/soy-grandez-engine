# ==========================================
# DATABASE CONFIGURATION (Laravel Sail MySQL)
# ==========================================
# Como Sail expone MySQL al puerto 3307 de tu máquina (por el FORWARD_DB_PORT)
# y tu motor Python correrá en Docker o en tu WSL, usaremos la IP de la red o host.
# Si el motor Python corre por fuera de Docker, usa 'localhost' o '127.0.0.1' con puerto 3307.
# Si corre dentro de Docker con docker-compose, puedes usar 'host.docker.internal' o el nombre del servicio.
DB_HOST=localhost
DB_PORT=3307
DB_NAME=stream_admin_db
DB_USER=deztream-grandez
DB_PASSWORD=soygrandez2006

# ==========================================
# LARAVEL API CONFIGURATION
# ==========================================
# Tu app corre en el puerto 8082 en local (APP_URL=http://localhost:8082)
LARAVEL_API_URL=http://localhost:8082/api
# Token de Sanctum (Genera un token de SuperAdmin en tu panel de Laravel y pégalo aquí)
LARAVEL_API_TOKEN=1|ktdRdhdm9vO2pOled1YxqjBsoOff8xtkYDvgANOW114be598
LARAVEL_API_EMAIL=grandezsalas192@gmail.com
LARAVEL_API_PASSWORD=tu_password_de_admin

# ==========================================
# ENCRYPTION KEY
# ==========================================
# Esta es la APP_KEY de tu Laravel (necesaria si tu motor Python necesita leer campos cifrados)
ENCRYPTION_KEY=n2E9PSjgv2U8sVqkLy7Pf1Vl4Pwp4Qml5dLycNknobA=

# ==========================================
# CAPSOLVER CONFIGURATION
# ==========================================
CAPSOLVER_API_KEY=tu_api_key_de_capsolver_aqui

# ==========================================
# BROWSER AUTOMATION SETTINGS
# ==========================================
# En desarrollo local ponlo en false para ver el navegador abrirse y depurar visualmente
BROWSER_HEADLESS=false
BROWSER_TIMEOUT=30000
SCREENSHOT_ON_ERROR=true

# ==========================================
# GMAIL API CONFIGURATION (Para lectura de OTP)
# ==========================================
GMAIL_CREDENTIALS_PATH=credentials.json
GMAIL_TOKEN_PATH=token.pickle
GMAIL_OTP_TIMEOUT=300
GMAIL_OTP_RETRY_INTERVAL=10

# ==========================================
# ORCHESTRATOR CONFIGURATION
# ==========================================
ORCHESTRATOR_MAX_CONCURRENT_TASKS=3
ORCHESTRATOR_SYNC_INTERVAL_MINUTES=60
ORCHESTRATOR_TASK_TIMEOUT=300
ORCHESTRATOR_MAX_RETRIES=3
ORCHESTRATOR_RETRY_DELAY=5

# ==========================================
# APPLICATION SETTINGS
# ==========================================
APP_ENV=development
LOG_LEVEL=DEBUG